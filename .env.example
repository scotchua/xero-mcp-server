# Xero API Configuration for Custom Connections
XERO_CLIENT_ID=your_client_id_here
XERO_CLIENT_SECRET=your_client_secret_here

# To use the multi-organisation PKCE auth-code flow instead of Custom
# Connections, uncomment the line below and run `npm run login` once to
# authorize. See README.md > Authentication > 3. Auth Code (PKCE).
# XERO_AUTH_MODE=auth_code 